# ---------------------------------------------------------------------------
# Ekravo Airport configuration
# ---------------------------------------------------------------------------
# Where this file lives
#   local / Docker : <repository>/.env
#   systemd        : /etc/ekravo-airport/airport.env
#   anywhere else  : set AIRPORT_ENV_FILE=/absolute/path/to/file
#
# Precedence: real environment variables override the file. Copy this file,
# then `chmod 600 .env`. Never commit a filled-in copy: .gitignore excludes it.
#
# Generate the JWT secret with:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------

# Interface and port for HTTP and WebSocket traffic. 0.0.0.0 is the container
# default; a local-only process should use 127.0.0.1:8787 instead.
AIRPORT_BIND_ADDR=0.0.0.0:8787

# Public origin used to build absolute wss:// URLs in ticket responses.
# Leave empty to return relative paths (clients join them to their base URL).
# AIRPORT_PUBLIC_URL=https://airport.example.com

# SQLite connection string. The directory is created and the file opened in WAL
# mode. Back up the .db file (and -wal during a copy) together.
AIRPORT_DATABASE_URL=sqlite://data/airport.db

# --- Authentication ---------------------------------------------------------

# REQUIRED. At least 32 characters. Rotating it invalidates every access token
# immediately; refresh tokens keep working until they expire.
AIRPORT_JWT_SECRET=

# Access token lifetime. Short is safer; the SDK refreshes automatically.
AIRPORT_ACCESS_TOKEN_TTL_SECS=900

# Refresh token lifetime. Tokens rotate on every use and reuse revokes the
# whole family.
AIRPORT_REFRESH_TOKEN_TTL_SECS=2592000

# How long a pairing code stays valid, and how long a connection ticket lives.
AIRPORT_PAIRING_TTL_SECS=600
AIRPORT_TICKET_TTL_SECS=90

# Open registration. When false, only the first account can be created; after
# that an operator must invite users (or set this back to true temporarily).
AIRPORT_ALLOW_REGISTRATION=true

# Authentication, registration, refresh/logout, and pairing attempts per
# client IP per minute. The same budget applies to per-account ticket and
# grant creation.
AIRPORT_AUTH_ATTEMPTS_PER_MINUTE=10

# --- Devices and connections ------------------------------------------------

AIRPORT_MAX_DEVICES_PER_USER=25
AIRPORT_MAX_CONNECTIONS_PER_USER=20
AIRPORT_MAX_QUEUE_DEPTH=256
AIRPORT_MAX_PAYLOAD_BYTES=262144
AIRPORT_MAX_FRAME_BYTES=1048576

# Messages retained for an offline device, and how long they stay valid.
AIRPORT_OFFLINE_QUEUE_LIMIT=500
AIRPORT_MESSAGE_TTL_SECS=86400

# Delivered/acknowledged messages and expired credentials are pruned after this.
AIRPORT_RETENTION_SECS=604800

# How many stored messages are replayed to a device on reconnect.
AIRPORT_REPLAY_BATCH=100

# --- Relay policy -----------------------------------------------------------

# Server heartbeat. Clients that stay silent for three intervals are dropped.
AIRPORT_HEARTBEAT_INTERVAL_SECS=25

# Per-connection token bucket. The burst is the bucket size.
AIRPORT_MESSAGES_PER_SECOND=20
AIRPORT_MESSAGE_BURST=40

# Reject unencrypted application messages. Enable only when every client uses
# the E2EE helpers; devices that speak plaintext will be refused.
AIRPORT_REQUIRE_E2EE=false

# Exact browser origins allowed to call the HTTP API cross-origin, comma
# separated. Empty means same-origin only (no CORS headers are emitted).
# AIRPORT_TRUSTED_ORIGINS=https://app.example.com,https://admin.example.com

# --- TLS --------------------------------------------------------------------

# In-process TLS. Set both or neither. Terminating TLS at a reverse proxy and
# leaving these empty is also supported and common. With TLS enabled Airport
# serves HTTPS/WSS only; there is no plaintext fallback or redirect. Set
# AIRPORT_PUBLIC_URL to the https origin so tickets contain wss:// URLs.
# AIRPORT_TLS_CERT=/etc/ekravo-airport/fullchain.pem
# AIRPORT_TLS_KEY=/etc/ekravo-airport/privkey.pem

# Read by the container healthcheck script (docker-healthcheck.sh), not by the
# server itself. TLS deployments must point the probe at https and provide the
# signing CA; verification is never disabled.
# AIRPORT_HEALTHCHECK_URL=https://127.0.0.1:8787/healthz
# AIRPORT_HEALTHCHECK_CA=/certs/ca.pem

# Trust X-Forwarded-For for rate limiting. Only enable behind a proxy you
# control; otherwise clients can choose their own rate-limit bucket.
AIRPORT_TRUST_PROXY=false

# --- Logging ----------------------------------------------------------------

# json (default, best for containers) or text (best for a terminal).
AIRPORT_LOG_FORMAT=json

# tracing filter. Keep payloads and tokens out of logs; Airport never logs them.
RUST_LOG=airport_server=info,airport=info,tower_http=warn
